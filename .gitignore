# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scraped personal data — never commit. Real names, national ID numbers,
# dates of birth and home addresses. Use the synthetic dataset instead:
# npm run db:seed  ->  _export/residents.synthetic.json
_scrape/data/residents.ndjson
_scrape/data/residents.state.json
